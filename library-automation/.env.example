# Manus AI API Key
# Get your API key from https://manus.ai
MANUS_API_KEY=your-manus-api-key-here

# Sunnyvale Public Library Configuration
LIBRARY_URL=https://sunnyvale.bibliocommons.com/

# Your library credentials
# Usually your library card number
LIBRARY_USERNAME=your-library-card-number

# Your library PIN or password
LIBRARY_PASSWORD=your-library-pin

# Comma-separated list of books to checkout
# Example: "Book Title 1,Book Title 2,Book Title 3"
LIBRARY_BOOKS=The Great Gatsby,To Kill a Mockingbird,1984
